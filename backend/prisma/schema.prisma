generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// There is no public registration for any role.
// - SUPER_ADMIN is created out-of-band via prisma/seed.js (see README).
// - INSTITUTE_ADMIN is created by the Super Admin, one per Institute,
//   at institute-creation time (POST /api/admin/institutes).
// - TEACHER / STUDENT / PARENT will be created by the institute itself
//   in a later phase, not implemented yet.
enum Role {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
}

model Institute {
  id        String          @id @default(uuid())

  // Unique login identifier the Super Admin assigns/generates when the
  // institute account is created, e.g. "P10001". This is what the
  // institute types into the "Institute ID" login field - the internal
  // UUID `id` remains the actual primary key / FK target.
  instituteCode String        @unique

  name      String
  email     String          @unique
  phone     String?
  logo      String?
  address   String?
  status    InstituteStatus @default(ACTIVE)

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  users User[]

  students  Student[]
  parents   Parent[]
  teachers  Teacher[]
  batches   Batch[]
  courses   Course[]
  subjects  Subject[]
  attendanceRecords Attendance[]

  feeStructures  FeeStructure[]
  studentFees    StudentFee[]
  feeInstallments FeeInstallment[]
  payments       Payment[]
  paymentReceipts PaymentReceipt[]
  paymentRefunds PaymentRefund[]

  tests          Test[]
  studentSubjectMarks StudentSubjectMark[]
  studentTestResults  StudentTestResult[]

  @@index([name])
  @@index([status])
  @@map("institutes")
}

model User {
  id           String   @id @default(uuid())
  instituteId  String?
  institute    Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name         String
  // Nullable + unique: SUPER_ADMIN logs in with a real email.
  // INSTITUTE_ADMIN logs in via Institute.instituteCode instead, so it
  // may not have one. Postgres treats multiple NULLs as distinct, so the
  // unique constraint still holds for rows that do have an email.
  email        String?  @unique
  passwordHash String
  role         Role     @default(STUDENT)

  refreshTokens RefreshToken[]
  teacher       Teacher?
  markedAttendanceRecords Attendance[]

  feeStructuresCreated FeeStructure[] @relation("FeeStructuresCreated")
  feesAssigned         StudentFee[]   @relation("FeesAssigned")
  paymentsReceived     Payment[]      @relation("PaymentsReceived")
  refundsProcessed     PaymentRefund[] @relation("RefundsProcessed")

  testsCreated         Test[]               @relation("TestsCreated")
  marksEntered         StudentSubjectMark[] @relation("MarksEntered")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // SUPER_ADMIN: instituteId = null.
  // INSTITUTE_ADMIN / TEACHER / STUDENT / PARENT: instituteId required in
  // practice, enforced at the service layer (Postgres can't conditionally
  // require a nullable FK based on an enum value).

  @@index([instituteId])
  @@index([role])
  @@map("users")
}

// Refresh tokens are stored hashed (never plaintext) so a DB leak alone
// can't be used to mint sessions. Rotation: each successful /auth/refresh
// call revokes the token used and issues a new row. Logout revokes it.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------
// Phase 3 - Students, Parents, Teachers, Batches
// Every model below carries a required instituteId. Tenant scoping is
// enforced at the service layer (every query is `where: { id, instituteId }`
// from the authenticated request context) - Postgres FKs alone can't
// express "these two rows must share the same institute" across a join
// table, so relationship writes (StudentParent, TeacherBatch, TeacherSubject)
// validate both sides belong to the same institute before creating a link.
// ---------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ParentRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model Student {
  id            String       @id @default(uuid())
  instituteId   String
  institute     Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  // Student-facing identifier, distinct from the internal `id`. Unique
  // per institute (not globally) - two institutes may each have "S001".
  studentCode   String

  firstName     String
  lastName      String
  profilePhoto  String?
  dateOfBirth   DateTime?
  gender        Gender?
  phone         String?
  email         String?
  address       String?
  admissionDate DateTime     @default(now())
  status        RecordStatus @default(ACTIVE)

  // Opaque random login-free identifier for QR attendance (Phase 4).
  // Generated server-side at creation (crypto random, see utils/qr-token.js)
  // - carries no student data, just an unpredictable lookup key.
  qrCode        String?      @unique

  batchId       String?
  batch         Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  parents       StudentParent[]
  attendanceRecords Attendance[]
  fees          StudentFee[]
  payments      Payment[]
  subjectMarks  StudentSubjectMark[]
  testResults   StudentTestResult[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([instituteId, studentCode])
  @@index([instituteId])
  @@index([instituteId, status])
  @@index([batchId])
  @@map("students")
}

model Parent {
  id          String       @id @default(uuid())
  instituteId String
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name        String
  phone       String?
  email       String?
  address     String?
  status      RecordStatus @default(ACTIVE)

  students    StudentParent[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([instituteId])
  @@index([instituteId, status])
  @@map("parents")
}

// Join table for the Student <-> Parent many-to-many. The relationship
// type lives here (per-link) rather than on Parent, since the same parent
// row could be "guardian" to one student and "father" to another.
model StudentParent {
  id           String             @id @default(uuid())

  studentId    String
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parentId     String
  parent       Parent             @relation(fields: [parentId], references: [id], onDelete: Cascade)

  relationship ParentRelationship @default(GUARDIAN)

  createdAt    DateTime           @default(now())

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@map("student_parents")
}

model Teacher {
  id           String       @id @default(uuid())
  instituteId  String
  institute    Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  // Optional link to a login account. No second auth system - if/when a
  // teacher needs to log in, this points at the existing Phase 2 User.
  userId       String?      @unique
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  name         String
  phone        String?
  email        String?
  profilePhoto String?
  address      String?
  joiningDate  DateTime     @default(now())
  status       RecordStatus @default(ACTIVE)

  batches      TeacherBatch[]
  subjects     TeacherSubject[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([instituteId])
  @@index([instituteId, status])
  @@map("teachers")
}

model Batch {
  id          String       @id @default(uuid())
  instituteId String
  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name        String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  status      RecordStatus @default(ACTIVE)

  courseId    String?
  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)

  students    Student[]
  teachers    TeacherBatch[]
  attendanceRecords Attendance[]
  feeStructures FeeStructure[]
  tests       Test[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([instituteId])
  @@index([instituteId, status])
  @@map("batches")
}

// Join table for the Teacher <-> Batch many-to-many.
model TeacherBatch {
  id        String   @id @default(uuid())

  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  batchId   String
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, batchId])
  @@index([teacherId])
  @@index([batchId])
  @@map("teacher_batches")
}

model Course {
  id          String    @id @default(uuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name        String
  description String?

  subjects    Subject[]
  batches     Batch[]
  feeStructures FeeStructure[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([instituteId])
  @@map("courses")
}

model Subject {
  id          String    @id @default(uuid())
  // Denormalized alongside courseId so subject queries can be tenant
  // -filtered directly without joining through Course every time.
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name        String

  teachers    TeacherSubject[]
  testSubjects TestSubject[]
  studentSubjectMarks StudentSubjectMark[]
  monthlyFeeGroupSubjects MonthlyFeeGroupSubject[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([instituteId])
  @@index([courseId])
  @@map("subjects")
}

// Join table for the Teacher <-> Subject many-to-many.
model TeacherSubject {
  id        String   @id @default(uuid())

  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId])
  @@index([teacherId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

// ---------------------------------------------------------------------
// Phase 4 - Attendance (QR + manual)
// Same tenant pattern as Phase 3: instituteId is required and re-checked
// alongside every relation, never inferred from studentId/batchId alone
// (a compromised/guessed id from another tenant must still fail the
// instituteId match). markedBy records who actually created the row -
// a teacher's own userId for QR/manual marking, never client-supplied.
// ---------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id          String           @id @default(uuid())
  instituteId String
  institute   Institute        @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  studentId   String
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  batchId     String
  batch       Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // Date-only (session/day granularity, not a timestamp) - this is what
  // the uniqueness rule keys on, so a student can't get two PRESENT rows
  // for the same batch on the same day via repeated QR scans.
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)

  markedById  String
  markedBy    User             @relation(fields: [markedById], references: [id], onDelete: Restrict)
  markedAt    DateTime         @default(now())

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, batchId, date])
  @@index([instituteId])
  @@index([batchId, date])
  @@index([studentId])
  @@map("attendance")
}

// ---------------------------------------------------------------------
// Phase 5 - Fees, Payments & Receipts
// Same tenant pattern as Phases 3-4: instituteId is required on every
// model and re-verified alongside student/feeStructure/studentFee
// relations, never inferred from one id alone.
//
// Money: every amount is Prisma Decimal (Postgres NUMERIC), never a JS
// float - see backend/src/utils/money.js for the Decimal helpers used
// in all authoritative calculations.
//
// FeeStructure.totalAmount / FeeStructureInstallment are the reusable
// template (e.g. "NEET 2026 - Rs 60,000 in 3 installments"). Assigning
// that structure to a student snapshots its numbers onto StudentFee /
// FeeInstallment at assignment time, so editing a FeeStructure later
// never retroactively changes an already-assigned student's fee.
// ---------------------------------------------------------------------

enum FeeStructureStatus {
  ACTIVE
  INACTIVE
}

enum FeeType {
  MONTHLY
  COURSE
}

enum CoursePaymentMode {
  FULL
  EMI
}

enum MonthlyPricingType {
  SUBJECT_WISE
  COMBINED
}

// Shared by StudentFee and FeeInstallment. OVERDUE is never written to
// the database directly - it's derived at read time by comparing dueDate
// to now for rows still PENDING/PARTIALLY_PAID (see utils/fee-status.js),
// so "is this overdue" is always correct without a background job.
enum FeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

// Manual payments recorded by staff are SUCCESS immediately. REFUNDED is
// an auditable status change, not a delete - see PaymentRefund below.
// No online-gateway states (PENDING/FAILED) yet; see Section 21 in the
// Phase 5 spec - this schema is shaped so that abstraction can slot in
// later without another migration to the core Payment model.
enum PaymentStatus {
  SUCCESS
  REFUNDED
}

model FeeStructure {
  id          String             @id @default(uuid())
  instituteId String
  institute   Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  name        String
  description String?
  totalAmount Decimal            @db.Decimal(12, 2)
  currency    String             @default("INR")
  status      FeeStructureStatus @default(ACTIVE)
  feeType     FeeType            @default(MONTHLY)
  courseId    String?
  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  coursePaymentMode CoursePaymentMode?
  monthlyDueDay Int?
  lateFee      Decimal            @default(0) @db.Decimal(12, 2)
  gracePeriodDays Int?

  // Optional association so a fee structure can be scoped to a specific
  // batch (e.g. "NEET 2026 batch fee"); not required.
  batchId     String?
  batch       Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User               @relation("FeeStructuresCreated", fields: [createdById], references: [id], onDelete: Restrict)

  installments FeeStructureInstallment[]
  monthlyGroups MonthlyFeeGroup[]
  studentFees  StudentFee[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([courseId])
  @@map("fee_structures")
}

model MonthlyFeeGroup {
  id               String             @id @default(uuid())
  feeStructureId   String
  feeStructure     FeeStructure       @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  name             String
  applicableLevel  String
  pricingType      MonthlyPricingType
  combinedAmount   Decimal?           @db.Decimal(12, 2)
  subjectPrices    MonthlyFeeGroupSubject[]
  studentFees      StudentFee[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([feeStructureId])
  @@map("monthly_fee_groups")
}

model MonthlyFeeGroupSubject {
  id                String          @id @default(uuid())
  monthlyFeeGroupId String
  monthlyFeeGroup   MonthlyFeeGroup @relation(fields: [monthlyFeeGroupId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  monthlyAmount     Decimal         @db.Decimal(12, 2)

  @@unique([monthlyFeeGroupId, subjectId])
  @@index([subjectId])
  @@map("monthly_fee_group_subjects")
}

// The installment *template* on a FeeStructure - copied into real
// FeeInstallment rows (with discount applied) when assigned to a student.
model FeeStructureInstallment {
  id               String       @id @default(uuid())

  feeStructureId   String
  feeStructure     FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)

  installmentNumber Int
  amount           Decimal      @db.Decimal(12, 2)
  dueDate          DateTime     @db.Date

  createdAt        DateTime     @default(now())

  @@unique([feeStructureId, installmentNumber])
  @@map("fee_structure_installments")
}

model StudentFee {
  id                String       @id @default(uuid())
  instituteId       String
  institute         Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  studentId         String
  student           Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  feeStructureId    String
  feeStructure      FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Restrict)
  feeStartDate      DateTime     @db.Date
  monthlyFeeGroupId String?
  monthlyFeeGroup   MonthlyFeeGroup? @relation(fields: [monthlyFeeGroupId], references: [id], onDelete: Restrict)

  // Snapshotted at assignment time - see model-level comment above.
  totalAmount       Decimal      @db.Decimal(12, 2)
  discountType      DiscountType @default(NONE)
  discountValue     Decimal      @default(0) @db.Decimal(12, 2)
  discountAmount    Decimal      @default(0) @db.Decimal(12, 2)
  finalAmount       Decimal      @db.Decimal(12, 2)
  paidAmount        Decimal      @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal      @db.Decimal(12, 2)
  status            FeeStatus    @default(PENDING)

  assignedById      String
  assignedBy        User         @relation("FeesAssigned", fields: [assignedById], references: [id], onDelete: Restrict)

  installments      FeeInstallment[]
  payments          Payment[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // One assignment of a given fee structure per student - prevents
  // accidental double-assignment. A student can still have several
  // *different* fee structures (tuition + hostel, etc).
  @@unique([studentId, feeStructureId])
  @@index([instituteId])
  @@index([instituteId, status])
  @@index([studentId])
  @@index([monthlyFeeGroupId])
  @@map("student_fees")
}

model FeeInstallment {
  id             String     @id @default(uuid())
  instituteId    String
  institute      Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  studentFeeId   String
  studentFee     StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)

  installmentNumber Int
  amount         Decimal    @db.Decimal(12, 2)
  dueDate        DateTime   @db.Date
  paidAmount     Decimal    @default(0) @db.Decimal(12, 2)
  status         FeeStatus  @default(PENDING)

  payments       Payment[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([studentFeeId, installmentNumber])
  @@index([instituteId])
  @@index([studentFeeId])
  @@index([dueDate])
  @@map("fee_installments")
}

model Payment {
  id                  String        @id @default(uuid())
  instituteId         String
  institute           Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  studentId           String
  student             Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentFeeId        String
  studentFee          StudentFee    @relation(fields: [studentFeeId], references: [id], onDelete: Restrict)

  installmentId       String
  installment         FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  amount              Decimal       @db.Decimal(12, 2)
  paymentMethod       PaymentMethod
  transactionReference String?
  paymentDate         DateTime      @default(now())
  notes               String?
  status              PaymentStatus @default(SUCCESS)

  receivedById        String
  receivedBy          User          @relation("PaymentsReceived", fields: [receivedById], references: [id], onDelete: Restrict)

  receipt             PaymentReceipt?
  refund              PaymentRefund?

  createdAt           DateTime      @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([instituteId])
  @@index([studentId])
  @@index([studentFeeId])
  @@index([installmentId])
  @@map("payments")
}

model PaymentReceipt {
  id                  String    @id @default(uuid())
  instituteId         String
  institute           Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  paymentId           String    @unique
  payment             Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Sequential per institute per year, e.g. "REC-2026-000001". Generated
  // inside the same transaction as the payment - see utils/receipt-number.js.
  receiptNumber       String    @unique

  // Snapshotted at issue time so the receipt reads correctly forever,
  // even after later payments change the running outstanding balance.
  previousOutstanding Decimal   @db.Decimal(12, 2)
  remainingOutstanding Decimal  @db.Decimal(12, 2)

  issuedAt            DateTime  @default(now())
  createdAt            DateTime @default(now())

  @@index([instituteId])
  @@map("payment_receipts")
}

// A refund is a reversal record, not a deletion of the original Payment.
// Not exposed via any endpoint yet (out of Phase 5 scope per spec Section
// 22), but the model exists now so a future phase can add refund
// endpoints without another schema migration.
model PaymentRefund {
  id           String    @id @default(uuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  paymentId    String    @unique
  payment      Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  amount       Decimal   @db.Decimal(12, 2)
  reason       String?

  processedById String
  processedBy  User      @relation("RefundsProcessed", fields: [processedById], references: [id], onDelete: Restrict)

  createdAt    DateTime  @default(now())

  @@index([instituteId])
  @@map("payment_refunds")
}

// ---------------------------------------------------------------------
// Phase 6 - Tests, Marks & Results
// Same tenant pattern as every prior phase: instituteId required on
// every model, re-verified alongside test/batch/subject relations.
//
// Design note (deviation from the spec's suggested shape): StudentSubjectMark
// links directly to (testId, studentId, subjectId) rather than nesting
// under a pre-existing StudentTestResult, because marks are entered
// subject-by-subject *before* a result exists. StudentTestResult is a
// computed rollup - upserted automatically once a student has marks
// recorded for every subject on the test, refreshed on every mark save,
// and only stamped with publishedAt when the whole Test is published.
// This avoids a chicken-and-egg "create a result to attach marks to
// before there's anything to result" ordering problem.
//
// Marks are plain Int (whole-number scores, per the spec's own examples
// - 82/100 etc.), not Decimal - this is explicitly not a financial
// module and doesn't touch Phase 5's money handling. Percentage is
// Decimal(5,2) since grade-boundary comparisons (e.g. 89.99 vs 90) need
// exact decimal comparison, not float - computed via the same generic
// Decimal helpers in utils/money.js already used for Phase 5 (a shared
// arithmetic utility, not something Phase 5-specific).
// ---------------------------------------------------------------------

enum TestStatus {
  DRAFT
  SCHEDULED
  COMPLETED
  PUBLISHED
  CANCELLED
}

enum ResultStatus {
  PASS
  FAIL
}

model Test {
  id              String     @id @default(uuid())
  instituteId     String
  institute       Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  batchId         String
  batch           Batch      @relation(fields: [batchId], references: [id], onDelete: Restrict)

  name            String
  description     String?
  testDate        DateTime   @db.Date
  durationMinutes Int?

  // Denormalized sum of TestSubject.maxMarks / passingMarks at test-level,
  // validated to match the subjects' sum whenever subjects change.
  totalMarks      Int
  passingMarks    Int

  status          TestStatus @default(DRAFT)

  createdById     String
  createdBy       User       @relation("TestsCreated", fields: [createdById], references: [id], onDelete: Restrict)

  subjects        TestSubject[]
  results         StudentTestResult[]
  subjectMarks    StudentSubjectMark[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([instituteId])
  @@index([instituteId, status])
  @@index([batchId])
  @@map("tests")
}

// Per-subject configuration for a test - "Physics -> 100 marks" etc.
model TestSubject {
  id           String   @id @default(uuid())

  testId       String
  test         Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  maxMarks     Int
  passingMarks Int

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Rejects duplicate subjects on the same test at the database level,
  // not just in application validation.
  @@unique([testId, subjectId])
  @@map("test_subjects")
}

// One row per student per subject per test - the raw entry teachers
// edit. maxMarks is snapshotted from TestSubject at entry time (same
// snapshot pattern as Phase 5's StudentFee), so a later subject
// max-marks edit never silently reinterprets an already-entered score.
model StudentSubjectMark {
  id             String   @id @default(uuid())
  instituteId    String
  institute      Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  testId         String
  test           Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectId      String
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  maxMarks       Int
  obtainedMarks  Int

  enteredById    String
  enteredBy      User     @relation("MarksEntered", fields: [enteredById], references: [id], onDelete: Restrict)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([testId, studentId, subjectId])
  @@index([instituteId])
  @@index([testId, studentId])
  @@map("student_subject_marks")
}

// Computed rollup - see the model-level design note above. Only exists
// once a student has a StudentSubjectMark row for every TestSubject on
// the test; kept in sync (upserted) on every mark save.
model StudentTestResult {
  id             String       @id @default(uuid())
  instituteId    String
  institute      Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  testId         String
  test           Test         @relation(fields: [testId], references: [id], onDelete: Cascade)

  studentId      String
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  totalMarks     Int
  obtainedMarks  Int
  percentage     Decimal      @db.Decimal(5, 2)
  grade          String
  status         ResultStatus

  // Set (alongside Test.status flipping to PUBLISHED) only when the
  // whole test is published - see services/result.service.js. Null
  // means "computed but not yet published", which is what Institute
  // Admin/Teacher review before publishing; Phase 7's future
  // student-facing endpoints would filter on this being non-null.
  publishedAt    DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([testId, studentId])
  @@index([instituteId])
  @@index([testId])
  @@index([studentId])
  @@map("student_test_results")
}
