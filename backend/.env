NODE_ENV=development
PORT=4000

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:NewStrongPassword123!@localhost:5432/student_saas?schema=public

# JWT secrets - use long random strings in real environments, e.g.:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Used once by `npm run seed` to create the first Super Admin.
# Not read anywhere else - safe to remove from .env after seeding.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=12345678
SUPER_ADMIN_NAME=Super Admin
